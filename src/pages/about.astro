---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';

const experience = ['[Role], [Company]', '[Role], [Company]', '[Role], [Company]'];
const services = ['Website design', 'Front-end development', 'Design systems'];
---

<Base title="About" description="About Damian Simpkins.">
  <section class="section">
    <div class="container"><div class="content-col stack">
      <h1 data-reveal class="intro">
        Replace with a short first-person introduction: who you are, your background and where you are now.
      </h1>
      <p data-reveal class="intro">
        A second paragraph on the kind of work you do, how you approach it and who you like working with.
      </p>
    </div></div>
  </section>

  <section class="section" aria-labelledby="experience">
    <div class="container split">
      <SectionHeader label="Experience" id="experience" />
      <ul class="plain-list">
        {experience.map((item) => <li data-reveal>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="services">
    <div class="container split">
      <SectionHeader label="Services" id="services" />
      <ul class="plain-list plain-list--columns">
        {services.map((item) => <li data-reveal>{item}</li>)}
      </ul>
    </div>
  </section>
</Base>
