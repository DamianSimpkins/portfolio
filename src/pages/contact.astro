---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Base title="Contact" description="Get in touch.">
  <section class="section">
    <div class="container"><div class="content-col stack">
      <h1 data-reveal class="intro">
        Replace with a line about the work you're open to. The best way to reach me is
        <a class="subtle-link" href="mailto:damian@webcoda.com.au">damian@webcoda.com.au</a>.
      </h1>
    </div></div>
  </section>

  <section class="section" aria-labelledby="elsewhere">
    <div class="container split">
      <SectionHeader label="Elsewhere" id="elsewhere" />
      <ul class="plain-list">
        <li data-reveal><a class="subtle-link" href="https://www.linkedin.com/">LinkedIn</a></li>
      </ul>
    </div>
  </section>
</Base>
