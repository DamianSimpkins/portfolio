---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Work" description="Selected projects.">
  <section class="section">
    <div class="container stack-lg">
      <h1 class="heading-01">Work</h1>
      <p class="lead measure">A selection of recent projects.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="projects">
    <div class="container">
      <SectionHeader number="01" label="All projects" id="projects" />
      <div class="grid-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</Base>
