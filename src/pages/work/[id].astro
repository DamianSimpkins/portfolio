---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Gallery from '../../components/Gallery.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { title, client, year, summary, type, url, process, services, galleryTop, galleryBottom } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary}>
  <div class="case">
    <section class="section">
      <h1 class="visually-hidden">{title}</h1>
      <div class="container split meta-strip">
        <dl>
          <div data-reveal><dt class="meta">Client</dt><dd>{client}</dd></div>
        </dl>
        <dl class="meta-strip__details">
          {type && <div data-reveal><dt class="meta">Project</dt><dd>{type}</dd></div>}
          <div data-reveal><dt class="meta">Year</dt><dd>{year}</dd></div>
          {url && (
            <div data-reveal>
              <dt class="meta">Website</dt>
              <dd><a class="subtle-link" href={url}>{new URL(url).hostname.replace(/^www\./, '')}</a></dd>
            </div>
          )}
        </dl>
      </div>
    </section>

    <section class="section" aria-labelledby="overview">
      <div class="container split">
        <SectionHeader label="Overview" id="overview" />
        <div class="intro stack" data-reveal>
          <Content />
        </div>
      </div>
    </section>

    {galleryTop.length > 0 && (
      <section class="section" aria-label="Project images">
        <div class="container">
          <Gallery items={galleryTop} />
        </div>
      </section>
    )}

    {(process || services.length > 0) && (
      <section class="section" aria-labelledby="what-i-did">
        <div class="container split">
          <SectionHeader label="What I did" id="what-i-did" />
          <div class="stack-lg">
            {process && <p class="intro" data-reveal>{process}</p>}
            {services.length > 0 && (
              <ul class="plain-list plain-list--columns services-list" style="--columns: 3">
                {services.map((service) => <li data-reveal>{service}</li>)}
              </ul>
            )}
          </div>
        </div>
      </section>
    )}

    {galleryBottom.length > 0 && (
      <section class="section" aria-label="More project images">
        <div class="container">
          <Gallery items={galleryBottom} />
        </div>
      </section>
    )}

    {next.id !== project.id && (
      <section class="section" aria-labelledby="next">
        <div class="container split">
          <SectionHeader label="Next project" id="next" />
          <a class="intro subtle-link next-project" href={`/work/${next.id}`} data-reveal>{next.data.title}</a>
        </div>
      </section>
    )}
  </div>
</Base>
