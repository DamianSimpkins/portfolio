---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectList from '../components/ProjectList.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <section class="section">
    <div class="container">
      <h1 data-reveal class="intro">
        I'm Head of UI/UX at Webcoda, a Sydney digital agency, where I lead design hands-on, from discovery through to delivery.
      </h1>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="selected-works">
    <div class="container stack">
      <SectionHeader label="Selected works" id="selected-works" />
      <ProjectList projects={projects} />
    </div>
  </section>
</Base>
