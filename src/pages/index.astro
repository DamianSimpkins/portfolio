---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectList from '../components/ProjectList.astro';

const featured = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <section class="section">
    <div class="container"><div class="content-col stack">
      <h1 data-reveal class="intro">
        I'm Damian Simpkins, a [role] based in [city]. Replace this with a sentence on what you do and who for.
      </h1>
      <p data-reveal class="intro">
        A second sentence or two on how you work and what you care about in the work.
      </p>
      <p data-reveal class="intro">
        Have a project in mind? <a class="subtle-link" href="/contact">Let's talk.</a>
      </p>
    </div></div>
  </section>

  <section class="section" aria-labelledby="featured">
    <div class="container split">
      <SectionHeader label="Selected work" id="featured" />
      <ProjectList projects={featured} />
    </div>
  </section>
</Base>
