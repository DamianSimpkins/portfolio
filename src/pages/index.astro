---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectList from '../components/ProjectList.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <section class="section">
    <div class="container">
      <h1 data-reveal class="intro">
        I'm a Sydney-based designer with over 20 years of experience crafting websites, apps and other digital products, for clients from startups to established brands. I'm currently a lead designer at Webcoda.
      </h1>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="selected-works">
    <div class="container stack">
      <SectionHeader label="Selected works" id="selected-works" />
      <ProjectList projects={projects} />
    </div>
  </section>
</Base>
