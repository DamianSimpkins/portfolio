---
interface Props {
  site: string;
}

const { site } = Astro.props;
---

<header class="nav">
  <div class="container nav__inner">
    <span class="nav__brand">{site}</span>
  </div>
</header>

<script>
  // Header text colour, worked out from the pixels directly behind each label. Over an image
  // it samples just the area under that label (allowing for how the image is cropped to fit)
  // and picks white or dark ink, whichever reads better against those pixels. Over the plain
  // page it uses the normal text colour. No overlay is involved.
  const images = [
    ...document.querySelectorAll<HTMLImageElement>('.case-hero img, .gallery img, .next-hero__media img'),
  ];

  // Elements that can sit over an image without hiding it
  const TRANSPARENT = '.next-hero__link, .next-hero__layer, .next-hero__media, .next-hero__text, .next-hero__text *, .case-hero, .case-hero__media';

  // Each image is read once into a small canvas; samples are taken from that
  const SAMPLE_WIDTH = 240;
  const samples = new WeakMap<HTMLImageElement, { ctx: CanvasRenderingContext2D; scale: number; width: number; height: number }>();

  const read = (img: HTMLImageElement) => {
    if (!img.naturalWidth || samples.has(img)) return;
    const scale = Math.min(1, SAMPLE_WIDTH / img.naturalWidth);
    const width = Math.max(1, Math.round(img.naturalWidth * scale));
    const height = Math.max(1, Math.round(img.naturalHeight * scale));
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!ctx) return;
    try {
      ctx.drawImage(img, 0, 0, width, height);
      ctx.getImageData(0, 0, 1, 1);
      samples.set(img, { ctx, scale, width, height });
      run();
    } catch {
      // Unreadable image: leave the label as it is
    }
  };

  // Contrast of white and of the dark ink against a pixel (0 to 255 channels)
  const INK = 0.007; // relative luminance of the dark text colour
  const lum = (r: number, g: number, b: number) =>
    0.2126 * (r / 255) ** 2.2 + 0.7152 * (g / 255) ** 2.2 + 0.0722 * (b / 255) ** 2.2;
  const PAD = 12;
  // Judge each colour by its weak spots, not its average: the contrast that 80% of the pixels
  // behind the label reach or beat. A bright patch on a dark area can't hide behind the mean.
  const WORST = 0.2;

  const percentile = (values: number[]) => {
    values.sort((a, b) => a - b);
    return values[Math.floor(values.length * WORST)];
  };

  // For the area behind a label: how well each text colour reads against it
  const score = (img: HTMLImageElement, box: DOMRect) => {
    const sample = samples.get(img);
    if (!sample) return null;
    const rect = img.getBoundingClientRect();
    // object-fit: cover: the image is scaled to cover the box and centred
    const cover = Math.max(rect.width / img.naturalWidth, rect.height / img.naturalHeight);
    const offsetX = (rect.width - img.naturalWidth * cover) / 2;
    const offsetY = (rect.height - img.naturalHeight * cover) / 2;
    const toCanvas = (value: number, offset: number, origin: number) =>
      ((value - origin - offset) / cover) * sample.scale;
    let x0 = Math.floor(toCanvas(box.left - PAD, offsetX, rect.left));
    let y0 = Math.floor(toCanvas(box.top - PAD, offsetY, rect.top));
    let x1 = Math.ceil(toCanvas(box.right + PAD, offsetX, rect.left));
    let y1 = Math.ceil(toCanvas(box.bottom + PAD, offsetY, rect.top));
    x0 = Math.max(0, x0);
    y0 = Math.max(0, y0);
    x1 = Math.min(sample.width, Math.max(x0 + 1, x1));
    y1 = Math.min(sample.height, Math.max(y0 + 1, y1));
    const { data } = sample.ctx.getImageData(x0, y0, x1 - x0, y1 - y0);
    const white: number[] = [];
    const dark: number[] = [];
    for (let i = 0; i < data.length; i += 4) {
      const l = lum(data[i], data[i + 1], data[i + 2]);
      white.push(1.05 / (l + 0.05));
      dark.push((l + 0.05) / (INK + 0.05));
    }
    return { white: percentile(white), dark: percentile(dark) };
  };

  // What is behind a label: the plain page, or an image (with how well each text colour reads
  // on the area behind the label), or unknown if there is nothing to go on yet
  type Probe = { kind: 'page' } | { kind: 'dark-surface' } | { kind: 'unknown' } | { kind: 'image'; img: HTMLImageElement; white: number; dark: number };

  const probe = (label: HTMLElement): Probe => {
    const box = label.getBoundingClientRect();
    const x = box.left + box.width / 2;
    const y = box.top + box.height / 2;
    const stack = document.elementsFromPoint(x, y).filter((el) => !el.closest('.nav, .back-link'));

    const forImage = (img: HTMLImageElement): Probe => {
      const result = score(img, box);
      return result ? { kind: 'image', img, ...result } : { kind: 'unknown' };
    };

    // While a page transition is running the browser draws its own layer over the page, and
    // the lookup finds nothing but the root. Go by where the images are instead.
    if (stack.every((el) => el === document.documentElement || el === document.body)) {
      const under = images.filter((img) => {
        const r = img.getBoundingClientRect();
        return r.width > 0 && x >= r.left && x <= r.right && y >= r.top && y <= r.bottom;
      });
      const img = under[under.length - 1];
      return img ? forImage(img) : { kind: 'unknown' };
    }

    // Whatever is topmost behind the text decides; an image further down the page that
    // happens to share that spot (e.g. behind the rising next hero) doesn't count
    for (const el of stack) {
      if (el instanceof HTMLImageElement && images.includes(el)) return forImage(el);
      if (el.matches(TRANSPARENT)) continue;
      // A dark panel (not an image): light text, whatever the theme
      if (el.closest('[data-surface="dark"]')) return { kind: 'dark-surface' };
      return { kind: 'page' };
    }
    return { kind: 'page' };
  };

  // Choose white or dark ink from how well each reads, with a little stickiness (in contrast
  // ratio) so it doesn't flip back and forth when both read about as well
  const STICKY = 0.6;
  const choose = (current: string | undefined, white: number, dark: number) => {
    if (current === 'dark') return white > dark + STICKY ? 'light' : 'dark';
    if (current === 'light') return dark > white + STICKY ? 'dark' : 'light';
    return dark > white ? 'dark' : 'light';
  };

  // Works out and applies the tone for each label
  function run() {
    const labels = [...document.querySelectorAll<HTMLElement>('.nav__brand, .back-link')];
    const probes = labels.map(probe);

    // The name and the Back link are judged on their own: they can sit over very different
    // parts of the same image
    labels.forEach((label, i) => {
      const found = probes[i];
      if (found.kind === 'page') label.dataset.tone = 'page';
      else if (found.kind === 'dark-surface') label.dataset.tone = 'light';
      else if (found.kind === 'image') label.dataset.tone = choose(label.dataset.tone, found.white, found.dark);
    });
  }

  // Scrolling fires a lot, so it is held to one check per frame; everything else runs at once so
  // a page that arrives without any scrolling has the right colour straight away
  let queued = false;
  function update() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      run();
    });
  }

  images.forEach((img) => {
    if (img.complete) read(img);
    else img.addEventListener('load', () => read(img), { once: true });
  });

  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', run);
  addEventListener('header-tone', run);
  addEventListener('load', run);
  // Re-check as a page transition starts and ends: nothing scrolls then, so nothing else would
  addEventListener('pagereveal', (event) => {
    const transition = (event as Event & { viewTransition?: ViewTransition }).viewTransition;
    transition?.ready.then(run, () => {});
    transition?.finished.then(run, () => {});
  });
  // And a few times while the page settles in
  [0, 250, 600, 1100, 1800].forEach((delay) => setTimeout(run, delay));
  run();
</script>
